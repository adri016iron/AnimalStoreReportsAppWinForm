                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=IIF(
    NOT IsNothing(Fields!DisponibleAdopcion.Value) AND
    NOT IsNothing(Fields!Esterilizado.Value) AND
    NOT IsNothing(Fields!Vacunado.Value) AND
    Fields!DisponibleAdopcion.Value AND
    Fields!Esterilizado.Value AND
    Fields!Vacunado.Value,
    "Listo para adopción",
    "No listo"
)</Value>
