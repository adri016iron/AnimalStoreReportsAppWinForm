using System;
using System.IO;
using System.Linq;
using System.Windows.Forms;
// No reference to System.Windows.Forms.DataVisualization to keep project lightweight
using TiendaAnimales.Entity;
using TiendaAnimales.Service;

namespace TiendaAnimales
{
    public partial class Graficos : Form
    {
        private DatosTienda datos;

        public Graficos()
        {
            InitializeComponent();
        }

        private void Graficos_Load(object sender, EventArgs e)
        {
            try
            {
                // Si no hay datos inyectados, cargamos del XML de la aplicación
                if (datos == null)
                {
                    string rutaXml = Path.Combine(Application.StartupPath, "Data", "DatosTienda.xml");
                    if (!File.Exists(rutaXml))
                    {
                        MessageBox.Show("No se encontró el archivo de datos: " + rutaXml, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                        return;
                    }

                    XmlDataService service = new XmlDataService();
                    datos = service.CargarDatos(rutaXml);
                }

                DibujarAnimalesPorTipo();
            }
            catch (Exception ex)
            {
                MessageBox.Show("Error al generar el gráfico: " + ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void DibujarAnimalesPorTipo()
        {
            chart1.Series.Clear();
            chart1.Titles.Clear();
            chart1.ChartAreas.Clear();

            // Si la aplicación no tiene la referencia a DataVisualization, dibujamos un resumen en una etiqueta.
            var grupos = datos.Animales
                .GroupBy(a => a.Especie)
                .Select(g => new { Especie = g.Key ?? "(sin especificar)", Cantidad = g.Count() })
                .OrderByDescending(x => x.Cantidad)
                .ToList();

            string texto = "Animales por especie:\r\n" + string.Join("\r\n", grupos.Select(g => $"{g.Especie}: {g.Cantidad}"));

            Label resumen = new Label();
            resumen.AutoSize = false;
            resumen.Dock = DockStyle.Fill;
            resumen.Text = texto;
            resumen.Font = new System.Drawing.Font("Segoe UI", 12F);
            resumen.Padding = new Padding(10);

            // Añadir la etiqueta al formulario en la posición del chart (reemplaza el control placeholder)
            resumen.Location = chart1.Location;
            resumen.Size = chart1.Size;
            this.Controls.Remove(chart1);
            this.Controls.Add(resumen);
        }

        private void btnProductos_Click(object sender, EventArgs e)
        {
            this.Close();
        }
    }
}